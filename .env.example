# ─── LLM ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini

# Para usar Ollama local en lugar de OpenAI:
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3

# ─── STT ──────────────────────────────────────────────────────────────────
STT_ENGINE=whisper          # whisper | deepgram
WHISPER_MODEL=tiny          # tiny | base | small | medium

# Para Deepgram:
# DEEPGRAM_API_KEY=your-key-here

# ─── TTS ──────────────────────────────────────────────────────────────────
TTS_ENGINE=pyttsx3          # pyttsx3 | elevenlabs

# Para ElevenLabs:
# ELEVENLABS_API_KEY=your-key-here
# ELEVENLABS_VOICE_ID=your-voice-id

# ─── Audio ────────────────────────────────────────────────────────────────
SAMPLE_RATE=16000
CHUNK_DURATION_MS=30
VAD_AGGRESSIVENESS=2        # 0-3, más alto = más agresivo filtrando no-habla

# ─── API Server ───────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
